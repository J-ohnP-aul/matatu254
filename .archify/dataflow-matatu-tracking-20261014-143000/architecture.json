  "cards": [
    {
      "dot": "emerald",
      "title": "GPS Ingestion",
      "items": [
        "Conductor device POSTs GPS to /trips/ping/<trip_id>/",
        "record_ping() validates auth, writes TripLocationLog",
        "ActiveTrip cache updated only if ping.timestamp > last_ping_at",
        "Triggers journey processing for each active session"
      ]
    },
    {
      "dot": "violet",
      "title": "Journey Status Engine",
      "items": [
        "update_journey_status() reads ActiveTrip.position",
        "is_near_stage() checks Haversine distance ≤ 20m per stage",
        "JourneySession FSM: SELECTED → IN_TRANSIT → APPROACHING → ARRIVED → ENDED",
        "Notifications created for passenger + conductor"
      ]
    },
    {
      "dot": "orange",
      "title": "Client Consumption",
      "items": [
        "Passenger app polls journey status & requests ETA",
        "remaining_road_distance() sums OSRM segments to destination",
        "OSRM fallback to Haversine (25 km/h) on failure",
        "Conductor receives approaching/arrived push alerts"
      ]
    }
  ]
}