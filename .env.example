# Local environment configuration for Matatu254 (copy to .env; never commit .env)
# Generate VAPID keys after installing requirements:
#   .venv/bin/vapid --gen
#   .venv/bin/vapid --applicationServerKey
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:ops@example.com
